# Supabase Configuration for Cloud Sync
# ==============================================================================
# SECURITY DIRECTIVE:
# - Use ONLY the public anonymous key (anon key) for VITE_SUPABASE_ANON_KEY.
# - NEVER put the 'service_role' key in client-side environment files.
# - Row Level Security (RLS) in supabase/schema.sql secures user data with anon key.
# ==============================================================================

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
